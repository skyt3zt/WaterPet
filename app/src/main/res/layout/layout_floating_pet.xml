<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- 悬浮桌宠卡通小形象（常驻边缘） -->
    <FrameLayout
        android:id="@+id/petContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/ivPet"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="喝水桌宠"
            android:src="@drawable/ic_water_pet" />
    </FrameLayout>

    <!-- 弹出的半小时喝水对话气泡 -->
    <LinearLayout
        android:id="@+id/bubbleCard"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_bubble"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 顶部标题与关闭按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvBubbleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/reminder_title"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:padding="2dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- 提醒正文 -->
        <TextView
            android:id="@+id/tvBubbleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/reminder_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- 操作按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDelay"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="稍后 (5m)"
                android:textColor="@color/btn_delay"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDrinkDone"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="喝了一杯 🥛"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
